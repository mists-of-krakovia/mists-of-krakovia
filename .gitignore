# ─── Segredos e ambiente ──────────────────────────────────────────────
# NUNCA commitar arquivos .env reais. Use os .env.example como modelo.
.env
.env.*
!.env.example
*.local

# ─── Dependências ─────────────────────────────────────────────────────
node_modules/
**/node_modules/

# ─── Build / artefatos ────────────────────────────────────────────────
dist/
build/
*.tsbuildinfo
frontend/dist/
frontend/build/

# ─── Supabase CLI ─────────────────────────────────────────────────────
# Arquivos temporários/locais do CLI. As migrations e o config SÃO versionados.
supabase/.branches/
supabase/.temp/
supabase/.env

# ─── Logs ─────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# ─── Editor / SO ──────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# ─── Diversos ─────────────────────────────────────────────────────────
_tmp_pdf/
coverage/
.cache/
