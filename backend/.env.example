# ─── Backend — Mists of Krakóvia ──────────────────────────────────────
# Copie este arquivo para `.env` e preencha com valores reais.
# O `.env` real NÃO é versionado (ver .gitignore).

# URL do projeto Supabase (ex.: https://SEU-PROJETO.supabase.co)
SUPABASE_URL=

# Service Role Key do Supabase — ACESSO TOTAL, ignora RLS.
# Usada SOMENTE no backend. Nunca exponha no frontend nem versione.
SUPABASE_SERVICE_KEY=

# Porta do servidor Express
PORT=3001

# Encontros aleatórios ao mover entre nós (Spec 2, Sub-parte E).
# Quando 'true', mover-se para um nó com encounter_rate > 0 e spawns ativos pode
# iniciar um combate (chance = encounter_rate do nó). Desligado por padrão para
# não atrapalhar a exploração. A ação "Caçar" no nó funciona independente disto.
ENCOUNTERS_ON_MOVE=false
